# ==============================================================================
# PathDeck .gitignore
# ==============================================================================
# Controls file visibility and repository hygiene:
# - Hides transient build artifacts, machine-specific caches, editor states, and secrets.
# - Preserves active working files, configuration definitions, and distribution assets.
# ==============================================================================

# ==============================================================================
# SECTION 1: WORKING & PRESERVED FILES (Explicit Whitelists)
# (Guarantees vital project sources, configs, and assets are preserved)
# ==============================================================================

# Core Project Configuration
!package.swift
!Package.swift
!.gitignore
!.swiftformat
!.markdownlint.json

# Documentation & Licensing
!readme*.md
!changelog.md
!license
!contributing.md

# ==============================================================================
# SECTION 2: HIDDEN & IGNORED ARTIFACTS
# (Local caches, intermediate builds, user states, credentials, diagnostics)
# ==============================================================================

# ------------------------------------------------------------------------------
# 2.1 macOS System & Volume Metadata
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
.ds_store
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
Icon?

# ------------------------------------------------------------------------------
# 2.2 Xcode Generated Projects, Workspaces & User State
# ------------------------------------------------------------------------------
*.xcodeproj/
*.xcodeproj
*.xcworkspace/
*.xcworkspace
*.xcuserdatad/
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3

# ------------------------------------------------------------------------------
# 2.3 Swift Package Manager & Tooling Caches
# ------------------------------------------------------------------------------
.build/
.swiftpm/

# ------------------------------------------------------------------------------
# 2.4 Build Products, Compilation Outputs & DerivedData
# ------------------------------------------------------------------------------
build/
DerivedData/
*.app/
*.app
*.ipa
*.pkg
*.dmg
*.dSYM.zip
*.dSYM
*.o
*.a
*.dylib
*.profdata
*.profraw
*.coverage
AppIcon.icns
appicon.icns
dmg_temp/

# ------------------------------------------------------------------------------
# 2.5 Distribution Archives & Release Bundles
# ------------------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz

# ------------------------------------------------------------------------------
# 2.6 Environment Secrets, Private Keys & Tokens
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.key
*.pem
*.p12
*.pfx
*.cer
*.crt
*.token
*.pat
.credentials
credentials.json
token.json
*secret*
*dsa_priv.pem
*ed25519_priv*

# ------------------------------------------------------------------------------
# 2.7 Diagnostics, Crash Logs & Local Telemetry
# ------------------------------------------------------------------------------
*.log
logs/
crash_reports/
*.crash
*.ips
*.diag

# ------------------------------------------------------------------------------
# 2.8 IDEs, Text Editors & AI Agent Working Contexts
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.gemini/
.claude/
.cursor/
.windsurf/
.codex/
antigravity.json
.nodeterm/

# ------------------------------------------------------------------------------
# 2.9 Temporary Files, Local Scratchpads & Local Internal Documents
# ------------------------------------------------------------------------------
*.tmp
*.temp
*.bak
tmp/
temp/
scratch/
local/
docs/internal/
task.md
todo.md
plan.md
report.md
report_template.md
